{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AWS Quick Manager",
  "version": "0.1.1",
  "identifier": "dev.httpdone.awsquickmanager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AWS Quick Manager",
        "width": 900,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2NTJFRjg4RDQ0RTkyOEMKUldTTWtrN1VpTzlTQmtZamg1d2dXTUJyV2hmZ3hXY1hUVDJQcW1HVk1Jc3VhWWxiR0tPblZ2UG0K",
      "endpoints": [
        "https://github.com/httpdone/aws-quick-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
